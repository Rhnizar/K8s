Vagrant.configure("2") do |config|

  SERVER_IP = "192.168.56.110"
  WORKER_IP = "192.168.56.111"

  # Use latest stable Ubuntu LTS (22.04 Jammy) as the base OS
  config.vm.box = "ubuntu/jammy64"


  # -------------------------
  # SERVER NODE (K3s controller )
  # -------------------------
  config.vm.define "ael-aminS" do |server|

    server.vm.hostname = "ael-aminS"

    # Attach a private network interface with a dedicated static IP
    server.vm.network "private_network", ip: SERVER_IP

    server.vm.provider "virtualbox" do |vb|
      # Set the VirtualBox VM display name
      vb.customize ["modifyvm", :id, "--name", "ael-aminS"]

      vb.memory = 1024

      vb.cpus = 1
    end

    server.vm.provision "shell", inline: <<-SHELL
      # Install K3s in controller (server) mode
      # --write-kubeconfig-mode 644 makes kubeconfig readable without sudo
      # --tls-san adds the server IP to the TLS certificate so agents can connect
      curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--write-kubeconfig-mode 644 --tls-san #{SERVER_IP}" sh -

      # Symlink the kubectl bundled with K3s so it is available as plain "kubectl"
      sudo ln -sf /usr/local/bin/k3s /usr/local/bin/kubectl

      # Share the node token with the worker via the synced /vagrant folder
      sudo cat /var/lib/rancher/k3s/server/node-token > /vagrant/node-token
    SHELL
  end

  # -------------------------
  # SERVER WORKER NODE (K3s agent)
  # -------------------------
  config.vm.define "ael-aminSW" do |worker|

    worker.vm.hostname = "ael-aminSW"

    # Attach a private network interface with a dedicated static IP
    worker.vm.network "private_network", ip: WORKER_IP

    worker.vm.provider "virtualbox" do |vb|
      # Set the VirtualBox VM display name
      vb.customize ["modifyvm", :id, "--name", "ael-aminSW"]

      vb.memory = 1024

      vb.cpus = 1
    end

    worker.vm.provision "shell", inline: <<-SHELL
      # Wait until the server has written the node token to the shared folder
      while [ ! -f /vagrant/node-token ]; do
        echo "Waiting for node token..."
        sleep 5
      done

      # Read the token written by the server node
      TOKEN=$(cat /vagrant/node-token)

      # Install K3s in agent mode, pointing to the server node
      curl -sfL https://get.k3s.io | K3S_URL="https://#{SERVER_IP}:6443" K3S_TOKEN=$TOKEN sh -
    SHELL
  end

end